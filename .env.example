# Neon Postgres (free tier — good for Vercel + mobile PWA)
#
# 1. neon.tech → New project → name it "kronos"
# 2. Dashboard → Connection details
# 3. Copy both strings below (replace password if prompted)
#
# App runtime (Vercel + local dev) — Pooled connection:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require"
#
# Migrations only (prisma migrate deploy) — Direct connection:
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require"
#
# Tip: Neon dashboard → Tables / SQL editor to inspect User, Tenant, TimeLog, etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Required in production (your Vercel URL, e.g. https://kronos.vercel.app)
# AUTH_URL="http://localhost:3000"

# Kit (ConvertKit) — optional. Without these, signup still works; emails are skipped.
KIT_API_KEY=""
KIT_FORM_ID=""

# Stripe — not wired yet. Checkout button is "coming soon".
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_PRO=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
